# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
# The module file pins the interpreter to a machine-specific path; each
# machine keeps its own (as ../sead_sexdiff does). The rest of .idea/ is shared.
.idea/*.iml

# Abstra
# Abstra is an AI-powered process automation framework.
# Ignore directories containing user credentials, local state, and settings.
# Learn more at https://abstra.io/docs
.abstra/

# Visual Studio Code
#  Visual Studio Code specific template is maintained in a separate VisualStudioCode.gitignore 
#  that can be found at https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore
#  and can be added to the global gitignore or merged into this file. However, if you prefer, 
#  you could uncomment the following to ignore the entire vscode folder
# .vscode/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor
#  Cursor is an AI-powered code editor. `.cursorignore` specifies files/directories to
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# ADNI is controlled-access (DUA): nothing participant-level is ever committed.
# Committed outputs are aggregate only (result.json, stage_means.csv,
# pls_loadings.csv, manifests with hashes, summary.md, group × stage counts,
# diagnostics tables, reports). scripts/sync_results.sh mirrors this list;
# change both together, in the change that adds a participant-level output.

# Raw ADNI files, uploaded by hand (ADNI_DATA_ROOT, default data/).
data/
# Cleaned matrices written by metabo_adni (participant × metabolite, keyed by
# RID), the p180 run table and metabo_adni's log. Only each platform's
# clean_manifest.json stays: git cannot re-include a file inside an excluded
# directory, so the platform directories are re-included first.
results/cleaned/**
!results/cleaned/*/
!results/cleaned/*/clean_manifest.json
# Cohort table: one row per participant. Only the counts and the manifest stay.
results/cohort/*.csv
!results/cohort/stage_counts.csv
# MOTCO inputs: blocks, metadata and covariates are participant-level. Only the
# manifests stay.
results/motco_input/**/*.csv
!results/motco_input/**/*manifest*
# MOTCO's per-participant scores and the metadata table the model saw, wherever
# an analysis is written (primary, sensitivity arms, variants).
results/**/latent_scores.csv
results/**/analysis_metadata.csv
# In-progress output directories and job logs (never aggregate outputs).
results/**/*.tmp/
results/**/logs/
# direnv / nix
.direnv/
